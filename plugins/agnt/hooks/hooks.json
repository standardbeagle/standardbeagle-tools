{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agnt hook pre-tool-use --session-id \"$CLAUDE_SESSION_ID\" --project-path \"$PWD\" 2>/dev/null || exit 0",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agnt hook post-tool-use --session-id \"$CLAUDE_SESSION_ID\" --project-path \"$PWD\" 2>/dev/null || exit 0",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agnt hook post-tool-use --event-override post-tool-use-failure --session-id \"$CLAUDE_SESSION_ID\" --project-path \"$PWD\" 2>/dev/null || exit 0",
            "timeout": 1
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agnt hook notification --session-id \"$CLAUDE_SESSION_ID\" 2>/dev/null || exit 0",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agnt hook stop --session-id \"$CLAUDE_SESSION_ID\" 2>/dev/null || exit 0",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
